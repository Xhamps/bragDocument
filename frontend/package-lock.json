{
  "name": "bragdoc-frontend",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bragdoc-frontend",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@bragdoc/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@bragdoc/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/app": {
      "name": "@bragdoc/app",
      "version": "0.0.0"
    },
    "packages/ui": {
      "name": "@bragdoc/ui",
      "version": "0.0.0"
    }
  }
}
