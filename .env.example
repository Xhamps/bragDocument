# Copy to .env. Values here are safe local defaults.

# PostgreSQL (docker compose)
POSTGRES_USER=brag
POSTGRES_PASSWORD=brag
POSTGRES_DB=brag
POSTGRES_PORT=5432

# Redis / Gotenberg (docker compose)
REDIS_PORT=6379
GOTENBERG_PORT=3000

# Supabase (identity provider) — from `supabase start` or your hosted dev project
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Telegram bot — from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

# App ports
API_PORT=8080
FRONTEND_PORT=5173
