# Copy to .env. Values here are safe local defaults.

# PostgreSQL (docker compose)
POSTGRES_USER=brag
POSTGRES_PASSWORD=brag
POSTGRES_DB=brag
POSTGRES_PORT=5432

# Redis / Gotenberg (docker compose)
REDIS_PORT=6379
GOTENBERG_PORT=3000

# Supabase (identity provider) — from `supabase start` or your hosted dev project
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Telegram bot — from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

# App ports
API_PORT=8080
FRONTEND_PORT=5173

# Backend (when running outside compose). `make run` reads DATABASE_URL and
# REDIS_URL from the environment; the rest are the built-in defaults.
DATABASE_URL=postgres://brag:brag@localhost:5432/brag?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=info
# LOG_FORMAT=json
# HTTP_ADDR=:8080
# DB_TIMEOUT=5s
# CACHE_TIMEOUT=200ms
# SHUTDOWN_TIMEOUT=15s
